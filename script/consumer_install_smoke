#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "bundler"
require "open3"
require "pathname"
require "rbconfig"
require "tmpdir"
require "rubygems/package"

ROOT = Pathname.new(__dir__).join("..").expand_path

def run!(*command, chdir: ROOT, env: {})
  puts "+ #{command.join(" ")}"
  success = system(env, *command, chdir: chdir.to_s)
  raise "command failed: #{command.join(" ")}" unless success
end

def run_unbundled!(*command, chdir: ROOT, env: {})
  Bundler.with_unbundled_env { run!(*command, chdir: chdir, env: env) }
end

def capture!(*command, chdir: ROOT, env: {})
  output, status = Open3.capture2e(env, *command, chdir: chdir.to_s)
  raise "command failed: #{command.join(" ")}\n#{output}" unless status.success?

  output
end

require ROOT.join("lib/typed_eav/version")
require "rails"

database = ENV.fetch("TYPED_EAV_CONSUMER_DATABASE", "typed_eav_consumer_smoke_#{Process.pid}")
database_url = ENV.fetch(
  "TYPED_EAV_CONSUMER_DATABASE_URL",
  "postgresql://#{ENV.fetch("PGUSER", "postgres")}:#{ENV.fetch("PGPASSWORD", "")}@" \
  "#{ENV.fetch("PGHOST", "localhost")}/#{database}",
)

# The block intentionally keeps the complete disposable consumer lifecycle in
# one ensure-protected scope so paths and database cleanup cannot escape it.
# rubocop:disable Metrics/BlockLength
Dir.mktmpdir("typed-eav-consumer-") do |tmp|
  tmp = Pathname.new(tmp)
  artifact = tmp.join("typed_eav-#{TypedEAV::VERSION}.gem")
  unpacked_root = tmp.join("package")
  host = tmp.join("host")

  supplied_artifact = ENV.fetch("TYPED_EAV_GEM_ARTIFACT", nil)
  if supplied_artifact
    supplied_artifact = Pathname.new(supplied_artifact).expand_path
    raise "supplied gem artifact does not exist: #{supplied_artifact}" unless supplied_artifact.file?

    FileUtils.cp(supplied_artifact, artifact)
  else
    run!(RbConfig.ruby, "-S", "gem", "build", "typed_eav.gemspec", "--output", artifact.to_s)
  end

  artifact_spec = Gem::Package.new(artifact.to_s).spec
  raise "supplied artifact is not typed_eav" unless artifact_spec.name == "typed_eav"
  raise "supplied artifact version does not match source" unless artifact_spec.version.to_s == TypedEAV::VERSION

  run!(RbConfig.ruby, "-S", "gem", "unpack", artifact.to_s, "--target", unpacked_root.to_s)
  package = unpacked_root.join("typed_eav-#{TypedEAV::VERSION}")
  package.join("typed_eav.gemspec").write(Gem::Package.new(artifact.to_s).spec.to_ruby)

  run!(
    RbConfig.ruby,
    Gem.bin_path("railties", "rails"),
    "new",
    host.to_s,
    "--skip-bundle",
    "--skip-git",
    "--skip-test",
    "--skip-system-test",
    "--skip-javascript",
    "--skip-asset-pipeline",
    "--database=postgresql",
  )

  host.join("Gemfile").write(<<~GEMFILE)
    source "https://rubygems.org"
    gem "rails", "#{Rails::VERSION::STRING}"
    gem "pg", "~> 1.1"
    gem "bootsnap", require: false
    gem "typed_eav", path: #{package.to_s.inspect}
  GEMFILE

  bundle = [RbConfig.ruby, Gem.bin_path("bundler", "bundle")]
  host_bundle_env = { "BUNDLE_GEMFILE" => host.join("Gemfile").to_s }
  run_unbundled!(*bundle, "install", chdir: host, env: host_bundle_env)

  rails = [*bundle, "exec", "rails"]
  app_env = host_bundle_env.merge("RAILS_ENV" => "test", "DATABASE_URL" => database_url)
  run_unbundled!(*rails, "typed_eav:install:migrations", chdir: host, env: app_env)
  first_install = Dir[host.join("db/migrate/*.typed_eav.rb")]
  run_unbundled!(*rails, "typed_eav:install:migrations", chdir: host, env: app_env)
  second_install = Dir[host.join("db/migrate/*.typed_eav.rb")]

  raise "second migration install changed the copied set" unless second_install == first_install

  source_stems = Dir[package.join("db/migrate/*.rb")].map do |path|
    File.basename(path).sub(/\A\d+_/, "")
  end.sort
  installed_stems = first_install.map do |path|
    File.basename(path).sub(/\A\d+_/, "").sub(".typed_eav.rb", ".rb")
  end.sort
  raise "packaged migrations were not copied completely" unless installed_stems == source_stems

  database_created = false
  begin
    run_unbundled!(*rails, "db:create", chdir: host, env: app_env)
    database_created = true
    run_unbundled!(*rails, "db:migrate", chdir: host, env: app_env)
    index_catalog_helper = <<~'RUBY'
      def typed_eav_smoke_index(connection, name)
        quoted_name = connection.quote(name)
        connection.select_one(<<~SQL.squish)
          SELECT
            index_state.indisvalid AS valid,
            index_state.indisready AS ready,
            index_state.indisunique AS unique,
            access_method.amname AS method,
            index_state.indnkeyatts AS key_count,
            pg_get_expr(index_state.indpred, index_state.indrelid) AS predicate,
            array_to_string(ARRAY(
              SELECT attribute.attname
              FROM unnest(index_state.indkey) WITH ORDINALITY AS index_column(attnum, position)
              JOIN pg_attribute attribute
                ON attribute.attrelid = index_state.indrelid AND attribute.attnum = index_column.attnum
              ORDER BY index_column.position
            ), ',') AS columns,
            array_to_string(ARRAY(
              SELECT operator_class.opcname
              FROM unnest(index_state.indclass) WITH ORDINALITY AS index_opclass(opcoid, position)
              JOIN pg_opclass operator_class ON operator_class.oid = index_opclass.opcoid
              WHERE index_opclass.position <= index_state.indnkeyatts
              ORDER BY index_opclass.position
            ), ',') AS opclasses
          FROM pg_class index_relation
          JOIN pg_index index_state ON index_state.indexrelid = index_relation.oid
          JOIN pg_class table_relation ON table_relation.oid = index_state.indrelid
          JOIN pg_am access_method ON access_method.oid = index_relation.relam
          WHERE table_relation.relname = 'typed_eav_values'
            AND index_relation.relname = #{quoted_name}
        SQL
      end
    RUBY
    schema_check = index_catalog_helper + <<~'RUBY'
      connection = ActiveRecord::Base.connection
      required_tables = %w[
        typed_eav_fields typed_eav_values typed_eav_options
        typed_eav_sections typed_eav_value_versions
      ]
      missing = required_tables.reject { |table| connection.data_source_exists?(table) }
      abort "missing tables: #{missing.join(', ')}" if missing.any?
      abort "missing field unique indexes" unless connection.indexes("typed_eav_fields").any?(&:unique)
      abort "missing value foreign keys" if connection.foreign_keys("typed_eav_values").empty?
      field_name = connection.columns("typed_eav_fields").find { |column| column.name == "name" }
      abort "missing field name constraint" if field_name.nil? || field_name.null

      expected = {
        "idx_te_values_field_int_present" => ["integer_value", "int8_ops"],
        "idx_te_values_field_dec_present" => ["decimal_value", "numeric_ops"],
        "idx_te_values_field_date_present" => ["date_value", "date_ops"],
        "idx_te_values_field_dt_present" => ["datetime_value", "timestamp_ops"],
        "idx_te_values_field_bool_present" => ["boolean_value", "bool_ops"],
        "idx_te_values_field_str_present" => ["string_value", "text_pattern_ops"],
      }
      expected.each do |name, (value_column, value_opclass)|
        row = typed_eav_smoke_index(connection, name)
        abort "missing replacement index #{name}" unless row
        abort "invalid replacement index #{name}" unless row.fetch("valid") && row.fetch("ready")
        abort "wrong access method for #{name}" unless row.fetch("method") == "btree"
        abort "unexpected unique index #{name}" if row.fetch("unique")
        abort "wrong keys for #{name}" unless row.fetch("key_count").to_i == 2
        abort "wrong columns for #{name}" unless row.fetch("columns").split(",") == ["field_id", value_column, "entity_id"]
        abort "wrong opclasses for #{name}" unless row.fetch("opclasses").split(",") == ["int8_ops", value_opclass]
        predicate = row.fetch("predicate").delete("()")
        abort "wrong predicate for #{name}" unless predicate == "#{value_column} IS NOT NULL"
      end
    RUBY
    run_unbundled!(*rails, "runner", schema_check, chdir: host, env: app_env)
    migration_path = first_install.find { |path| path.end_with?("_use_partial_covering_scalar_indexes.typed_eav.rb") }
    raise "missing installed partial-covering migration" unless migration_path

    migration_version = File.basename(migration_path).split("_", 2).first
    run_unbundled!(*rails, "db:migrate:down", "VERSION=#{migration_version}", chdir: host, env: app_env)
    legacy_schema_check = index_catalog_helper + <<~'RUBY'
      connection = ActiveRecord::Base.connection
      expected = {
        "idx_te_values_field_int" => ["integer_value", "int8_ops"],
        "idx_te_values_field_dec" => ["decimal_value", "numeric_ops"],
        "idx_te_values_field_date" => ["date_value", "date_ops"],
        "idx_te_values_field_dt" => ["datetime_value", "timestamp_ops"],
        "idx_te_values_field_bool" => ["boolean_value", "bool_ops"],
        "idx_te_values_field_str" => ["string_value", "text_pattern_ops"],
      }
      expected.each do |name, (value_column, value_opclass)|
        row = typed_eav_smoke_index(connection, name)
        abort "missing legacy index #{name}" unless row
        abort "invalid legacy index #{name}" unless row.fetch("valid") && row.fetch("ready")
        abort "wrong access method for #{name}" unless row.fetch("method") == "btree"
        abort "unexpected unique index #{name}" if row.fetch("unique")
        abort "wrong keys for #{name}" unless row.fetch("key_count").to_i == 2
        expected_columns = ["field_id", value_column, "entity_id", "entity_type"]
        abort "wrong columns for #{name}" unless row.fetch("columns").split(",") == expected_columns
        abort "wrong opclasses for #{name}" unless row.fetch("opclasses").split(",") == ["int8_ops", value_opclass]
        abort "unexpected predicate for #{name}" if row.fetch("predicate")
      end
    RUBY
    run_unbundled!(*rails, "runner", legacy_schema_check, chdir: host, env: app_env)
    run_unbundled!(*rails, "db:migrate:up", "VERSION=#{migration_version}", chdir: host, env: app_env)
    run_unbundled!(*rails, "runner", schema_check, chdir: host, env: app_env)
  ensure
    run_unbundled!(*rails, "db:drop", chdir: host, env: app_env) if database_created
  end
end
# rubocop:enable Metrics/BlockLength

puts "Consumer migration installation smoke test passed"
